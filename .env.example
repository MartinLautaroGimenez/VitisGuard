# VitisGuard — variables de entorno. Copiar a .env y ajustar.
# (dotenv se carga automáticamente al arrancar run.py)

# --- Flask ---
VITISGUARD_CONFIG=development
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria

# --- Base de datos ---
# Por defecto SQLite en data/vitisguard.db. Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/vitisguard

# --- Microservicio de IA (ai_service/) ---
AI_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8001
AI_TIMEOUT=8

# --- Alertas ---
ALERT_CAPTURE_THRESHOLD=5
ALERT_WINDOW_DAYS=7
NODE_OFFLINE_HOURS=6
SCHEDULER_ENABLED=true

# --- Notificaciones: log | email | whatsapp ---
NOTIFIER_BACKEND=log
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# WhatsApp (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+549261XXXXXXX

# --- MQTT (Mosquitto sobre TLS) ---
# Requiere mosquitto instalado y corriendo (ver mosquitto/mosquitto.conf).
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_CA_CERT=certs/ca.crt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_BASE=vitisguard
MQTT_TRUST_CLIENTS=true
